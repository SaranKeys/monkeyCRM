datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  EMPLOYEE
  CLIENT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERN
  CONTRACTOR
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  PAUSED
  CHURNED
}

enum EngagementType {
  PROJECT
  RETAINER
  RETAINER_BUILD
}


enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum MilestoneType {
  INTERNAL_MEETING
  CLIENT_MEETING
  MILESTONE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum MilestoneStatus {
  UPCOMING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ApprovalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
  REWORK_REQUESTED
}

enum PhaseStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
}

enum TaskStatus {
  TO_DO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskUpdateType {
  UPDATE
  QUESTION
}


type Attachment {
  name String
  url  String
  type String // 'video', 'document', 'image'
}


// Embedded Documents
type AdditionalContact {
  name  String
  role  String
  email String
  phone String
  tag   String // 'billing', 'technical', 'escalation'
}

type SaarthiLeadData {
  status           String  
  door             String?
  painStatement    String?
  sketch           Json?
  qualification    Json?
  fitScore         String?
  summaryForParam  String?
  conversationId   String
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  role      Role     @default(EMPLOYEE)
  isActive  Boolean  @default(true)
  
  resetOtp       String?
  resetOtpExpiry DateTime?

  resetToken       String?
  resetTokenExpiry DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeProfile EmployeeProfile?
  clientProfile   ClientProfile?

  createdTickets Ticket[]        @relation("TicketCreator")
  ticketComments TicketComment[] @relation("CommentAuthor")

  projectUpdates ProjectUpdate[] @relation("UpdateAuthor")
  updateReplies  UpdateReply[]   @relation("UpdateReplyAuthor")

  taskUpdates       TaskUpdate[]      @relation("TaskUpdateAuthor")
  taskUpdateReplies TaskUpdateReply[] @relation("TaskUpdateReplyAuthor")

  pushSubscriptions PushSubscription[]

  timeLogs TaskTimeLog[] @relation("TimeLogAuthor")
  activityLogs ProjectActivityLog[]

  uploadedFiles ProjectFile[] @relation("FileUploader")

  @@map("users")
}

model EmployeeProfile {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Personal & Identity
  legalName       String
  preferredName   String?
  dob             DateTime
  gender          Gender
  profilePhotoUrl String?
  personalMobile  String
  bloodGroup      String?

  // Emergency Contact
  emergencyName     String
  emergencyRelation String
  emergencyPhone    String

  // KYC & Identity Documents
  aadhaarNumber   String @unique
  aadhaarFrontUrl String // csu
  aadhaarBackUrl  String // csu
  panNumber       String @unique
  panPhotoUrl     String // csu

  // Address
  currentAddress   String
  addressProofUrl  String // csu
  permanentAddress String

  // Bank & Payroll
  accountName     String
  bankName        String
  accountNumber   String
  ifscCode        String
  branchName      String
  bankDocumentUrl String // Passbook or Cancelled Cheque URL

  // Employment Details
  designation      String
  department       String
  reportingManager String? // Can be linked to another User ID later
  employmentType   EmploymentType
  workMode         WorkMode
  baseLocation     String
  dateOfJoining    DateTime
  probationDays    Int
  totalExperience  Float
  relevantExp      Float

  // Relations to Projects
  ledProjects Project[] @relation("ProjectLead")

  projectIds String[]  @db.ObjectId
  projects   Project[] @relation("ProjectMembers", fields: [projectIds], references: [id])

  assignedTickets Ticket[] @relation("TicketAssignee")

  ownedMilestones ProjectMilestone[] @relation("MilestoneOwner")

  updatesToApprove ProjectUpdate[] @relation("UpdateApprover")

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  // projectMilestones ProjectMilestone[]

  ledPhases     ProjectPhase[] @relation("PhaseLead")
  assignedTasks PhaseTask[]    @relation("TaskAssignee")

  sentMessages ChatMessage[] @relation("ChatSender")
  

  @@map("employee_profiles")
}

model ClientProfile {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Company Basics
  companyName String // Required
  brandName   String?
  logoUrl     String? // csu
  website     String?
  industry    String?
  companySize String?
  foundedYear Int?
  description String?
  linkedin    String?

  // Primary Contact
  contactName        String // Required
  contactEmail       String // Required
  contactPhone       String // Required
  contactDesignation String?
  contactMethod      String?
  timezone           String?

  // Additional Contacts (Embedded Array)
  additionalContacts AdditionalContact[]

  // Addresses
  registeredAddress String?
  operatingAddress  String?
  country           String?

  // Billing & Legal
  billingCurrency String?
  billingContact  String?
  billingEmail    String?
  taxId           String? // Dynamic based on region
  paymentTerms    String?
  paymentMethod   String?
  poRequired      Boolean? @default(false)

  // Relationship / Commercial
  clientSince    DateTime?
  source         String?
  accountOwner   String?
  engagementType EngagementType?
  status         ClientStatus?   @default(PROSPECT)

  // Document URLs (Drive URLs)
  msaUrl         String?
  ndaUrl         String?
  taxCertUrl     String?
  brandAssetsUrl String?

  // Relation to Projects
  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("client_profiles")
}

// ==========================================
// SALES & PROSPECTS (CRM)
// ==========================================

model Lead {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  firstName   String
  email       String
  phoneE164   String?
  company     String?
  
  // Statuses from your spec: TALKING_TO_SAARTHI, SKETCH_DONE, QUALIFIED, CALL_BOOKED, HANDED_TO_HUMAN, CLOSED_NONE
  status      String   @default("TALKING_TO_SAARTHI") 
  
  // 🟢 This embeds the AI's intelligence directly into the CRM Lead
  saarthi     SaarthiLeadData? 
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("leads")
}

model CompanyRole {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String  @unique
  description String?

  permissions Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company_roles")
}

model ServiceTemplate {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String @unique
  icon String

  page2Fields Json

  isActive Boolean @default(true)

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("service_templates")
}

//  project flow 
model Project {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  // basic Details
  name        String
  description String?

  serviceId String          @db.ObjectId
  service   ServiceTemplate @relation(fields: [serviceId], references: [id])

  priority       ProjectPriority
  engagementType EngagementType
  status         ProjectStatus   @default(ACTIVE)

  // relation to Client
  clientId String        @db.ObjectId
  client   ClientProfile @relation(fields: [clientId], references: [id])

  clientRequirements Json?

  estimatedHours     Int?
  techStack          String[]
  customInstructions String?

  // "+1 / +2" Resource Counters
  requiredResources Json?

  // Relation: Project Lead 
  leadId String?          @db.ObjectId
  lead   EmployeeProfile? @relation("ProjectLead", fields: [leadId], references: [id])

  // Relation: Project Members
  memberIds String[]          @db.ObjectId
  members   EmployeeProfile[] @relation("ProjectMembers", fields: [memberIds], references: [id])

  // Project Runway
  milestones ProjectMilestone[]

  tickets Ticket[]

  updates ProjectUpdate[]

  phases ProjectPhase[]

  chatMessages ChatMessage[]

  projectFiles ProjectFile[]

  activityLogs ProjectActivityLog[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("projects")
}

model ProjectMilestone {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  type        MilestoneType
  dueDate     DateTime

  status MilestoneStatus @default(UPCOMING)

  ownerId String?          @db.ObjectId
  
  owner   EmployeeProfile? @relation("MilestoneOwner", fields: [ownerId], references: [id])

  agenda      String?
  decisions   String?
  actionItems String?

  isCompleted Boolean @default(false)

  projectId String  @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("project_milestones")
}

model Ticket {

  id String @id @default(auto()) @map("_id") @db.ObjectId
  ticketNumber String @unique

  subject  String
  details  String
  priority ProjectPriority
  status   TicketStatus    @default(OPEN)

  projectId String  @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  creatorId String? @db.ObjectId 
  creator   User?   @relation("TicketCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  assigneeId String?          @db.ObjectId
  assignee   EmployeeProfile? @relation("TicketAssignee", fields: [assigneeId], references: [id])

  comments TicketComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tickets")
}

model TicketComment {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  text String

  ticketId String @db.ObjectId
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String? @db.ObjectId 
  author   User?   @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ticket_comments")
}


model ProjectUpdate {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  content String

  attachments Attachment[]
  clientView     Boolean        @default(true)
  approvalStatus ApprovalStatus @default(NONE)

  projectId String  @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorId String? @db.ObjectId 
  author   User?   @relation("UpdateAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  replies UpdateReply[]

  assignedApproverId String?          @db.ObjectId
  assignedApprover   EmployeeProfile? @relation("UpdateApprover", fields: [assignedApproverId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("project_updates")
}


model UpdateReply {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  text String

  updateId String        @db.ObjectId
  update   ProjectUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)

  authorId String? @db.ObjectId 
  author   User?   @relation("UpdateReplyAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("update_replies")
}


model ProjectPhase {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  description    String?
  startDate      DateTime
  dueDate        DateTime
  priority       ProjectPriority @default(MEDIUM)
  status         PhaseStatus     @default(UPCOMING)
  
  estimatedHours Int             @default(0)
  loggedHours    Int             @default(0)

  deliverables   Attachment[]

  projectId      String          @db.ObjectId
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  leadId         String?         @db.ObjectId
  lead           EmployeeProfile? @relation("PhaseLead", fields: [leadId], references: [id])

  showToClient   Boolean    @default(false)

  subPhases      PhaseSubPhase[]
  tasks          PhaseTask[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("project_phases")
}

model PhaseSubPhase {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  name      String

  phaseId   String       @db.ObjectId
  phase     ProjectPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  tasks     PhaseTask[]

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("phase_sub_phases")
}

model PhaseTask {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  title       String

  description    String?
  attachments    Attachment[]
  
  startDate   DateTime?
  dueDate     DateTime?

  priority    ProjectPriority @default(MEDIUM)
  status      TaskStatus      @default(TO_DO)

  estimatedHours Int          @default(0) 
  loggedHours    Int          @default(0)

  phaseId     String          @db.ObjectId
  phase       ProjectPhase    @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  subPhaseId  String?         @db.ObjectId
  subPhase    PhaseSubPhase?  @relation(fields: [subPhaseId], references: [id], onDelete: SetNull)

  assigneeId  String?         @db.ObjectId
  assignee    EmployeeProfile? @relation("TaskAssignee", fields: [assigneeId], references: [id])

  updates     TaskUpdate[]

  timeLogs TaskTimeLog[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("phase_tasks")
}

model ChatMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  text      String

  projectId String   @db.ObjectId
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  senderId  String?          @db.ObjectId 
  sender    EmployeeProfile? @relation("ChatSender", fields: [senderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("chat_messages")
}

model ProjectFile {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String    
  url         String 
  driveFileId String    
  type        String    
  
  projectId   String   @db.ObjectId
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  uploaderId  String?   @db.ObjectId 
  uploader    User?     @relation("FileUploader", fields: [uploaderId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("project_files")
} 


model TaskUpdate {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  type      TaskUpdateType @default(UPDATE) 

  taskId    String         @db.ObjectId
  task      PhaseTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId  String?        @db.ObjectId 
  author    User?          @relation("TaskUpdateAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  replies   TaskUpdateReply[]

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("task_updates")
}

model TaskUpdateReply {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  text      String

  updateId  String         @db.ObjectId
  update    TaskUpdate     @relation(fields: [updateId], references: [id], onDelete: Cascade)

  authorId  String?        @db.ObjectId 
  author    User?          @relation("TaskUpdateReplyAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("task_update_replies")
}

model TaskTimeLog {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  hours     Int        
  date      DateTime
  note      String?

  taskId    String    @db.ObjectId
  task      PhaseTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId  String?   @db.ObjectId 
  author    User?     @relation("TimeLogAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("task_time_logs")
}

model ProjectActivityLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  
  projectId String   @db.ObjectId
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  actorId   String?  @db.ObjectId 
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  action    String   
  details   String   

  createdAt DateTime @default(now())

  @@map("project_activity_logs")
}

model PushSubscription {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  endpoint  String
  p256dh    String
  auth      String

  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}


// ==========================================
// SAARTHI ENUMS & COMPOSITE TYPES (MONGODB)
// ==========================================

enum SaarthiConfigStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SaarthiStage {
  GATE
  DIAGNOSE
  REFRAME
  QUALIFY
  CLOSE
  ENDED
}

type SaarthiVisitorData { // All the info about the human talking to the bot.
  firstName      String?
  email          String?
  phoneE164      String?
  company        String?
  country        String?
  tz             String?
  ipHash         String
  userAgent      String
  freeMail       Boolean?
  existingClient Boolean?
  whatsappOptIn  Boolean  @default(false)
}

type SaarthiTurnLLM { // tracks exactly what happened under the hood for one single message
  modelKey      String
  provider      String
  promptVersion Int
  tokensIn      Int
  tokensOut     Int
  costINR       Float
  latencyMs     Int
  fallbackUsed  Boolean
}

type SaarthiGuardrailHit { // A log of every time the AI (or the user) broke a safety rule
  guardrailKey String // which rule was broken, e.g., "price_mention_limit
  version      Int
  scope        String // 'input' | 'output'
  action       String
  matched      String?
  severity     String
  at           DateTime
}

type SaarthiTurn { // One single message in the chat history
  id            String   @default(uuid())
  at            DateTime @default(now())
  channel       String   // 'web' | 'whatsapp' | 'email' | 'admin'
  role          String   // 'visitor' | 'saarthi' | 'system' | 'human_agent'
  text          String
  stageAtTurn   String
  extraction    Json?    // Validated JSON from LLM
  llm           SaarthiTurnLLM?
  guardrailHits SaarthiGuardrailHit[]
  rewrittenFrom String?
}

type SaarthiConfigSnapshot { // stores the exact version numbers of the rules they started with
  personaV          Int?
  settingsV         Int?
  fitRuleV          Int?
  modelAssignmentV  Int?
  promptVersions    Json?
  guardrailVersions Json?
  icpVersions       Json?
  doorVersions      Json?
  offerVersions     Json?
}

type SaarthiTelemetry { // total stats for the entire conversation combined
  tokensIn      Int @default(0)
  tokensOut     Int @default(0)
  costINR       Float @default(0)
  durationS     Float @default(0)
  llmCalls      Int @default(0)
  avgLatencyMs  Int @default(0)
  guardrailHits SaarthiGuardrailHit[]
  dropOffStage  String?
}

// ==========================================
// SAARTHI CORE MODELS
// ==========================================

model SaarthiModel { // A list of all the AI models you can plug in
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  key               String   @unique
  provider          String   // 'anthropic' | 'openai' | 'openai_compatible' | 'ollama'
  modelId           String
  baseUrl           String?
  apiKeyRef         String?  // Reference to secret manager
  params            Json
  supportsStreaming Boolean  @default(true)
  supportsJsonMode  Boolean  @default(false)
  contextWindow     Int
  costPer1MInput    Float
  costPer1MOutput   Float
  costCurrency      String   @default("USD")
  enabled           Boolean  @default(true)
  healthStatus      String   @default("unknown")
  lastHealthCheckAt DateTime?
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String   @default("system")

  @@map("saarthi_models")
}

model SaarthiPersona { // How the AI behaves. You can have multiple drafts, but only one live persona
  id                     String              @id @default(auto()) @map("_id") @db.ObjectId
  version                Int
  status                 SaarthiConfigStatus @default(DRAFT)
  name                   String
  displayName            String
  roleTitle              String
  openingLine            String
  aiDisclosure           String
  warmth                 Int
  humour                 Int
  directness             Int
  formality              Int
  curiosity              Int
  maxSentencesPerMessage Int                 @default(4)
  maxQuestionsPerMessage Int                 @default(1)
  questionsBudget        Json                // { diagnose: 4, qualify: 3 }
  reflectEveryNMessages  Int                 @default(2)
  nameUsage              String              @default("sparingly")
  languagePolicy         Json
  emojiPolicy            String              @default("none")
  jargonPolicy           String              @default("only_if_visitor_technical")
  humourScope            String[]
  humourForbidden        String[]
  signOff                String
  customDirectives       String[]
  voiceSamples           Json[]              // Array of { visitor, saarthi }

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String
  publishedAt DateTime?
  publishedBy String?
  changeNote  String?

  @@map("saarthi_personas")
}

model SaarthiGuardrail { // strict rules to keep the AI from messing up
  id                   String              @id @default(auto()) @map("_id") @db.ObjectId
  key                  String
  version              Int
  status               SaarthiConfigStatus @default(DRAFT)
  label                String
  description          String
  enabled              Boolean             @default(true)
  scope                String              // 'input' | 'output' | 'both'
  kind                 String              // 'keyword' | 'regex' | 'classifier' | 'llm_judge' | 'counter' | 'composite'
  config               Json
  action               String              // 'block_replace' | 'rewrite' | 'soft_steer' | 'escalate' | 'redact' | 'log_only'
  severity             String              // 'low' | 'medium' | 'high' | 'critical'
  replacementTemplateId String?
  rewriteInstruction   String?
  order                Int
  stopOnHit            Boolean             @default(true)
  testCases            Json[]
  category             String

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String
  publishedAt DateTime?
  publishedBy String?
  changeNote  String?

  @@map("saarthi_guardrails")
}

model SaarthiConversation { // master file for a single visitor's chat
  id                 String                @id @default(auto()) @map("_id") @db.ObjectId
  sessionId          String                @unique
  leadId             String?               @db.ObjectId // Optional link to OS Lead
  visitor            SaarthiVisitorData
  stage              SaarthiStage          @default(GATE)
  endedReason        String?
  door               String?
  doorConfidence     Float?
  painStatement      Json?                 // { text, confirmed }
  sketch             Json?                 // { changes, humanStep, plugsInto, accepted }
  qualification      Json?                 // { timeline, decisionMaker, budgetSignal, funnel, funnelConfidence }
  fit                Json?                 // { score, ruleVersion, routedToUserId, explanation }
  pricing            Json?                 // { anchorQuoted, pilotQuoted, timesMentioned }
  briefs             Json?                 // { light: {}, full: {} }
  booking            Json?                 // { slot, ownerUserId, calendarEventId, noShowCount }
  
  escalated          Boolean               @default(false)
  escalationReason   String?
  takenOverByUserId  String?               @db.ObjectId
  takenOverAt        DateTime?
  
  turns              SaarthiTurn[]         // Embedded array for insane read/write speeds
  configSnapshot     SaarthiConfigSnapshot
  telemetry          SaarthiTelemetry
  
  summaryForParam    String?
  flags              Json                  // { reviewed, rating, reviewerNote, isTestSandbox }
  tags               String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String   @default("system")

  @@map("saarthi_conversations")
}

model SaarthiAuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  at          DateTime @default(now())
  userId      String   @db.ObjectId
  action      String
  entity      String
  entityId    String   @db.ObjectId
  fromVersion Int?
  toVersion   Int?
  diff        Json?
  ip          String?

  @@map("saarthi_audit_logs")
}


model SaarthiModelAssignment {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  version     Int                 @default(1)
  status      SaarthiConfigStatus @default(PUBLISHED)
  roles       Json                // { brain: { primaryModelKey: "gemini-primary", fallbackModelKeys: [] } }
  changeNote  String?
  publishedAt DateTime?           @default(now())
  publishedBy String?

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("saarthi_model_assignments")
}